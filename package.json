{
  "name": "@stacklys/tsconfig",
  "version": "1.0.1",
  "private": false,
  "description": "📦 Strict, zero-waste, and modern TypeScript base configurations for typescript projects.",
  "keywords": [
    "stacklys",
    "tsconfig",
    "typescript"
  ],
  "homepage": "https://github.com/Stacklys/tsconfig",
  "bugs": {
    "url": "https://github.com/Stacklys/tsconfig/issues"
  },
  "author": "Luis Monsalve",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stacklys/tsconfig.git"
  },
  "files": [
    "base.json",
    "dom.json",
    "strict.json"
  ],
  "type": "module",
  "exports": {
    "./base": "./base.json",
    "./strict": "./strict.json",
    "./dom": "./dom.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "setup": "bunx gitlys init",
    "lint": "oxlint --fix",
    "format": "oxfmt",
    "security:audit": "bun audit",
    "release": "bun run lint && bun run format && bunx gitlys release"
  },
  "devDependencies": {
    "@stacklys/oxlint-config": "^1.0.4",
    "gitlys": "^2.2.4"
  },
  "engine": {
    "node": ">=22.17.0",
    "bun": ">=1.4.2"
  }
}