{
  "name": "@stacklys/tsconfig",
  "version": "0.0.0",
  "author": "Luis Monsalve",
  "description": "📦 Strict, zero-waste, and modern TypeScript base configurations for typescript projects.",
  "private": false,
  "homepage": "https://github.com/Stacklys/tsconfig",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Stacklys/tsconfig.git"
  },
  "bugs": {
    "url": "https://github.com/Stacklys/tsconfig/issues"
  },
  "keywords": [
    "typescript",
    "tsconfig",
    "stacklys",
    "typescript"
  ],
  "exports": {
    "./base": "./base.json",
    "./strict": "./strict.json",
    "./react": "./react.json"
  },
  "files": [
    "base.json",
    "react.json",
    "strict.json"
  ],
  "engine": {
    "node": ">=22.17.0",
    "bun": ">=1.1.0"
  },
  "scripts": {
    "preinstall": "npx only-allow bun",
    "postinstall": "bunx gitlys init",
    "lint": "eslint . --fix --cache",
    "security:audit": "bun audit",
    "release": "bun run lint && bunx run gitlys"
  },
  "devDependencies": {
    "eslint-config-universal-code": "^1.1.5",
    "gitlys": "2.2.4"
  }
}